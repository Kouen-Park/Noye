# Where the Noye backend is listening. Baked into the browser bundle at build
# time, so a change needs a rebuild, not just a restart.
#
# Calls go straight from the browser to FastAPI rather than through a Next
# rewrite, so this origin must appear in the backend's FRONTEND_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
