# macOS
.DS_Store

# Environment
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Node / Next.js
node_modules/
.next/
out/
dist/
coverage/
*.tsbuildinfo

# Local application data
data/app.db
# WAL journal mode (see app/db/database.py) creates these alongside the db.
data/app.db-wal
data/app.db-shm

# Uploaded sources and generated documents are the user's own files. They are
# never committed — the directories are kept, their contents are not. The old
# rule here named data/uploads/, a path the code does not use, so every upload
# was in fact trackable.
data/sources/*
!data/sources/.gitkeep
data/documents/*
!data/documents/.gitkeep
qdrant_storage/

# IDE / local agent tooling
.idea/
.vscode/
.kiro/

# Logs
*.log

# Throwaway design mockups
.mockups/
