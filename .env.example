BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# Optional cloud generation. Keep the key here (never NEXT_PUBLIC_*).
# Restart the backend after changing these values, then select Gemini in the UI.
# Embeddings and vector search still use local Ollama/Qdrant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# qwen3.5 is a reasoning model. Leave thinking disabled for RAG answers:
# with thinking on, a one-sentence answer cost ~1550 tokens / 82s on an M2,
# versus ~30 tokens / 3s with it off. Pass "think": false to the Ollama API.
OLLAMA_THINKING=false

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=noye
# Output dimension of OLLAMA_EMBEDDING_MODEL (embeddinggemma = 768).
# Changing the embedding model requires recreating the collection.
QDRANT_VECTOR_SIZE=768

DATABASE_URL=sqlite:///./data/app.db
