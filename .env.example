BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
# Pilot prefixes reduced Recall@5; keep raw unless a measured comparison justifies a rebuild.
EMBEDDING_INPUT_FORMAT=raw-v1
# Request-size guard including prefixes; model token limits use truncate=false.
EMBEDDING_MAX_INPUT_CHARS=8192

# Optional cloud generation. Keep the key here (never NEXT_PUBLIC_*).
# Web: restart the backend, then explicitly select a provider in the UI.
# Desktop: use AI Settings and macOS Keychain instead of plaintext key files.
# Embeddings and vector search still use local Ollama/Qdrant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# qwen3.5 is a reasoning model. Leave thinking disabled for RAG answers:
# with thinking on, a one-sentence answer cost ~1550 tokens / 82s on an M2,
# versus ~30 tokens / 3s with it off. Pass "think": false to the Ollama API.
OLLAMA_THINKING=false

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=noye
# Output dimension of OLLAMA_EMBEDDING_MODEL (embeddinggemma = 768).
# Rebuild after embedding changes; only a dimension change recreates the collection.
QDRANT_VECTOR_SIZE=768

# Changing these processing settings also requires an explicit rebuild.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

DATABASE_URL=sqlite:///./data/app.db
